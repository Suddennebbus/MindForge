# ── 数据库 ──
# 默认 SQLite（无需配置）；如需 Postgres 取消下行注释
# DATABASE_URL=postgresql://mindforge:mindforge@localhost:5432/mindforge

# ── 密钥 ──
# 留空则首次启动自动生成随机密钥并持久化到 <DATA_DIR>/.secrets
# 仅在需要从其他环境迁移数据时才显式设置
SECRET_KEY=
ENCRYPTION_KEY=

# ── 数据目录 ──
DATA_DIR=./data

# ── CORS（逗号分隔；生产同源部署无需修改）──
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
